{
  "name": "what-if-social-network",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "dev:worker": "wrangler dev",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "deploy:cloudflare": "npm run deploy",
    "deploy": "npm run db:migrate:remote && wrangler deploy"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "express": "^5.2.1",
    "helmet": "^7.1.0",
    "sanitize-html": "^2.11.0",
    "sqlite3": "^6.0.1",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "wrangler": "^4.124.0"
  },
  "engines": {
    "node": ">=20"
  },
  "cloudflare": {
    "bindings": {
      "DB": {
        "description": "Permanent D1 storage for accounts, challenges, answers, votes, stories, and moderation data."
      }
    }
  }
}
